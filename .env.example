# Copy to .env.local for local development (gitignored), and set the same value as a
# GitHub Actions repository variable named VITE_SUPABASE_ANON_KEY for deploys.
# Supabase dashboard → Project Settings → API → "anon" / publishable key. It is public by
# design; access is enforced by the edge functions verifying each user's token.
VITE_SUPABASE_ANON_KEY=

# Optional: defaults to the production project.
# VITE_SUPABASE_URL=https://fkhwdotwrfedwaddaalv.supabase.co
