# Copy to .env.local for local development (gitignored). For deploys, set the same names
# as GitHub Actions repository variables (Settings → Secrets and variables → Actions →
# Variables). Both values are public by design: access is enforced by the edge functions
# verifying each signed-in user's token.

# Supabase project URL (Project Settings → API). Edge function URLs are built from it:
#   <VITE_SUPABASE_URL>/functions/v1/project-players
#   <VITE_SUPABASE_URL>/functions/v1/player-lines
VITE_SUPABASE_URL=https://fkhwdotwrfedwaddaalv.supabase.co

# Supabase "anon" / publishable key (Project Settings → API).
VITE_SUPABASE_ANON_KEY=
